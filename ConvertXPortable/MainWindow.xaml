<Window x:Class="ConvertXPortable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Portable ConvertX" Height="760" Width="1180"
        MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="Inter, Segoe UI, Microsoft YaHei UI"
        Background="#101419">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="8"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"
                        CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#E0E2EA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#C0C7D4" />
    <SolidColorBrush x:Key="QuietBrush" Color="#8A919E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F8AE0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#330078D4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FCC5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB689" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B31C2026" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#80181C22" />
    <SolidColorBrush x:Key="LineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TerminalBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="TerminalBarBrush" Color="#181C22" />

    <DropShadowEffect x:Key="ShellShadow"
                      BlurRadius="40"
                      ShadowDepth="12"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.45" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#4D272A30" />
      <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#66272A30" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="#66272A30" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          RecognizesAccessKey="True" />
                        <Path Grid.Column="1"
                              Width="9"
                              Height="5"
                              Stretch="Fill"
                              Fill="{StaticResource MutedBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 4.5 5 L 9 0 Z" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#80363940" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#66A3C9FF" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#80363940" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,4,0,0"
                        Background="#F01C2026"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="6"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.5" />
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="#660078D4" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemRoot" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#66272A30" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#80363940" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#66A3C9FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Color="#0078D4"
                                  Opacity="0.55" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#80363940" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="#660078D4" />
      <Setter Property="Foreground" Value="#A3C9FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TagStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="StatusTagTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#82DA82" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter Property="Foreground" Value="#FFB689" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusTagBorderStyle" TargetType="Border" BasedOn="{StaticResource TagStyle}">
      <Setter Property="Background" Value="#332D5F2D" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter Property="Background" Value="#33744B14" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="#66272A30" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#80363940" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#66A3C9FF" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#80363940" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#66A3C9FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="#404752" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track"
                    Width="44"
                    Height="24"
                    CornerRadius="12"
                    Background="{TemplateBinding Background}">
              <Ellipse x:Name="Thumb"
                       Width="18"
                       Height="18"
                       Fill="White"
                       HorizontalAlignment="Left"
                       Margin="3,0,0,0">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.24" />
                </Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#26FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#3DFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E81123" />
                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#C50F1F" />
                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#101419" Offset="0" />
        <GradientStop Color="#181C22" Offset="0.48" />
        <GradientStop Color="#1C2026" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Border x:Name="ShellBorder"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            Background="#B31C2026">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Margin" Value="8" />
          <Setter Property="CornerRadius" Value="12" />
          <Setter Property="Effect" Value="{StaticResource ShellShadow}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
              <Setter Property="Margin" Value="0" />
              <Setter Property="CornerRadius" Value="0" />
              <Setter Property="Effect" Value="{x:Null}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#66272A30"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,0,0,1">
          <Grid Margin="16,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0078D4" Offset="0" />
                    <GradientStop Color="#00A38A" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="CX"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Portable ConvertX" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text=" "
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <ToggleButton x:Name="ToolStatusToggle"
                            Style="{StaticResource StatusToggleStyle}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding AvailableToolSummary}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>

              <Popup PlacementTarget="{Binding ElementName=ToolStatusToggle}"
                     Placement="Bottom"
                     HorizontalOffset="-230"
                     VerticalOffset="10"
                     StaysOpen="False"
                     IsOpen="{Binding IsChecked, ElementName=ToolStatusToggle}">
                <Border Width="360"
                        Background="#F01C2026"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.55" />
                  </Border.Effect>
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}" Background="#332D5F2D">
                        <TextBlock Text="健康" Foreground="#82DA82" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="本地转换器" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ToolStatuses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#4D272A30"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="8"
                                  Padding="10,8"
                                  Margin="0,0,0,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                              </StackPanel>
                              <Border Grid.Column="1" Style="{StaticResource StatusTagBorderStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTagTextStyle}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>

            <Button Grid.Column="2"
                    Content="⚙"
                    ToolTip="设置"
                    Click="SettingsNav_Click"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button x:Name="MinimizeButton"
                      Style="{StaticResource WindowControlButtonStyle}"
                      Click="MinimizeButton_Click"
                      ToolTip="最小化">
                <Path Width="10" Height="1"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      Data="M0,0 L10,0" />
              </Button>
              <Button x:Name="MaximizeRestoreButton"
                      Click="MaximizeRestoreButton_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                    <Setter Property="ToolTip" Value="最大化" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="ToolTip" Value="还原" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid Width="10" Height="10">
                  <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             StrokeThickness="1"
                             Fill="Transparent">
                    <Rectangle.Style>
                      <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Rectangle.Style>
                  </Rectangle>
                  <Grid>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Rectangle Width="8" Height="8"
                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               StrokeThickness="1"
                               Fill="Transparent"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top" />
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Fill="Transparent"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Data="M0,2 L0,8 L6,8 L6,2 Z M0,2 L6,2" />
                  </Grid>
                </Grid>
              </Button>
              <Button x:Name="CloseButton"
                      Style="{StaticResource WindowCloseButtonStyle}"
                      Click="CloseButton_Click"
                      ToolTip="关闭">
                <Path Width="10" Height="10"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      Data="M0,0 L10,10 M10,0 L0,10" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="198" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="#4D181C22"
                  BorderBrush="#1FFFFFFF"
                  BorderThickness="0,0,1,0"
                  Padding="10,14">
            <StackPanel>
              <TextBlock Text="转换" Foreground="{StaticResource QuietBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,8" />
              <Button x:Name="HomeNavButton" Style="{StaticResource ActiveNavButtonStyle}" Click="HomeNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⇄" Foreground="{StaticResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="首页" />
                </StackPanel>
              </Button>

              <TextBlock Text="管理" Foreground="{StaticResource QuietBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,18,0,8" />
              <!-- <Button Style="{StaticResource NavButtonStyle}" Click="ConvertersNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="◫" Foreground="{StaticResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="转换器" />
                </StackPanel>
              </Button> -->
              <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚙" Foreground="{StaticResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="设置" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="14,12,14,14">
                <DockPanel x:Name="HomeSection" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="文件转换" FontSize="23" FontWeight="SemiBold" />
                  <TextBlock Text="选择输入文件、目标格式和转换器，输出结果会保存在指定目录。"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="14"
                             Margin="0,6,0,0" />
                </StackPanel>
              </DockPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.45*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="0.9*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="单文件模式" Foreground="#A3C9FF" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="转换任务" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            MinHeight="120"
                            Padding="20"
                            CornerRadius="12"
                            BorderBrush="#400078D4"
                            BorderThickness="2"
                            Background="#33181C22"
                            AllowDrop="True"
                            Drop="DropZone_Drop"
                            DragOver="DropZone_DragOver">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="拖入文件或点击选择" FontSize="17" FontWeight="SemiBold" />
                          <TextBox Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}"
                                   IsReadOnly="True"
                                   Margin="0,8,0,0" />
                          <TextBlock Text="可拖拽单个文件到这里，应用会自动识别可用输出格式。"
                                     Foreground="{StaticResource MutedBrush}"
                                     FontSize="13"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="选择输入文件"
                                Style="{StaticResource BaseButtonStyle}"
                                Click="ChooseFile_Click"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0" />
                      </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="输出格式" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding SelectedOutputFormat}" />
                      </StackPanel>

                      <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="转换器" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ConverterOptions}"
                                  SelectedItem="{Binding SelectedConverterOption}"
                                  DisplayMemberPath="DisplayName" />
                      </StackPanel>

                      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                          <Button Grid.Column="2"
                                  Content="选择目录"
                                  Style="{StaticResource BaseButtonStyle}"
                                  Click="ChooseOutputDirectory_Click" />
                        </Grid>
                      </StackPanel>

                      <Border Grid.Row="4"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Padding="10"
                              CornerRadius="10"
                              Background="#4D272A30"
                              BorderBrush="{StaticResource LineSoftBrush}"
                              BorderThickness="1">
                        <DockPanel>
                          <ToggleButton x:Name="NvidiaAccelerationToggle"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SwitchToggleStyle}"
                                        ToolTip="开启后自动写入 ffmpeg CUDA/NVENC 参数"
                                        Checked="NvidiaAccelerationToggle_Checked"
                                        Unchecked="NvidiaAccelerationToggle_Unchecked"
                                        Margin="16,0,0,0" />
                          <StackPanel>
                            <TextBlock Text="ffmpeg NVIDIA 硬件加速" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="预留参数：-hwaccel cuda -c:v h264_nvenc，默认关闭"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                          </StackPanel>
                        </DockPanel>
                      </Border>

                      <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="高级参数" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding AdvancedArguments, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：-crf 20 -preset fast" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Content="开始转换"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="StartConvert_Click"
                              IsEnabled="{Binding CanStart}"
                              Margin="0,0,10,0" />
                      <Button Content="取消"
                              Style="{StaticResource BaseButtonStyle}"
                              Click="CancelConvert_Click"
                              IsEnabled="{Binding IsConverting}"
                              Margin="0,0,10,0" />
                      <Button Content="打开结果文件夹"
                              Style="{StaticResource BaseButtonStyle}"
                              Click="OpenOutputDirectory_Click" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="12,9"
                            CornerRadius="10"
                            BorderBrush="#4D5FCC5F"
                            BorderThickness="1"
                            Background="#33184F18">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="✓" Foreground="#82DA82" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                          <TextBlock Text="{Binding StatusText}" Foreground="#82DA82" FontSize="13" FontWeight="Bold" />
                          <TextBlock Text="{Binding OutputDirectory}" Foreground="#A4D9A4" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <Border Style="{StaticResource PanelBorderStyle}" Padding="0" Height="360">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}" Background="#332D5F2D">
                          <TextBlock Text="{Binding StatusText}" Foreground="#82DA82" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="简单终端" FontSize="17" FontWeight="SemiBold" />
                      </DockPanel>
                      <Border Grid.Row="1"
                              Margin="0"
                              CornerRadius="10"
                              Background="{StaticResource TerminalBrush}"
                              ClipToBounds="True">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <DockPanel Background="{StaticResource TerminalBarBrush}" LastChildFill="False">
                            <TextBlock Text="转换日志"
                                       Foreground="#B9C4D4"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="实时输出"
                                       Foreground="#B9C4D4"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                          </DockPanel>
                          <TextBox Grid.Row="1"
                                   Text="{Binding LogText}"
                                   IsReadOnly="True"
                                   TextWrapping="Wrap"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   Background="{StaticResource TerminalBrush}"
                                   Foreground="#D9E2EF"
                                   BorderThickness="0"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="13"
                                   Padding="12"
                                   VerticalContentAlignment="Top" />
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>

                </StackPanel>
              </Grid>

              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel Margin="14,12,14,14">
                <StackPanel x:Name="SettingsSection">
                <DockPanel Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="设置" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="这里展示后续设置页的布局结构，正式开发时可映射到 WPF-UI NavigationView 页面。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="General" Foreground="#A3C9FF" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="通用设置" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="默认输出文件夹" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="默认转换器" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ConverterOptions}"
                                  SelectedItem="{Binding SelectedConverterOption}"
                                  DisplayMemberPath="DisplayName" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border x:Name="ConverterManagementSection" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <TextBlock Text="转换器管理" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ToolStatuses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#4D272A30"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="8"
                                  Padding="10,8"
                                  Margin="0,0,0,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="3" Style="{StaticResource StatusTagBorderStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTagTextStyle}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="Theme" Foreground="#A3C9FF" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="主题设置" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border Padding="14" CornerRadius="10" Background="#4D272A30" BorderBrush="#660078D4" BorderThickness="1">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FFFFFF" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#EEF3F8" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}" />
                          </StackPanel>
                          <TextBlock Text="浅色主题" FontWeight="SemiBold" />
                          <TextBlock Text="Mica + 浅色 Fluent" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" Padding="14" CornerRadius="10" Background="#4D272A30" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#10151F" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#1D2532" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#4CC2FF" />
                          </StackPanel>
                          <TextBlock Text="暗黑主题" FontWeight="SemiBold" />
                          <TextBlock Text="高对比终端友好" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="4" Padding="14" CornerRadius="10" Background="#4D272A30" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#F7FBFF" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#10151F" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}" />
                          </StackPanel>
                          <TextBlock Text="系统跟随" FontWeight="SemiBold" />
                          <TextBlock Text="跟随 Windows 主题" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
