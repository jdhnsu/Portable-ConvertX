<Window x:Class="ConvertXPortable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ConvertXPortable.Controls"
        Title="Portable ConvertX" Height="760" Width="1180"
        MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="pack://application:,,,/Resources/icon.ico"
        FontFamily="Inter, Segoe UI, Microsoft YaHei UI"
        Background="Transparent">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="8"
                        GlassFrameThickness="-1"
                        UseAeroCaptionButtons="False"
                        CornerRadius="12" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DropShadowEffect x:Key="ShellShadow"
                      BlurRadius="40"
                      ShadowDepth="12"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.45" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          RecognizesAccessKey="True" />
                        <Path Grid.Column="1"
                              Width="9"
                              Height="5"
                              Stretch="Fill"
                              Fill="{DynamicResource MutedBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 4.5 5 L 9 0 Z" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,4,0,0"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        BorderBrush="{DynamicResource PopupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="6"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.5" />
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <TextBlock VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}">
                <ContentPresenter x:Name="ContentHost" />
              </TextBlock>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemRoot" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Color="#660067C0"
                                  Opacity="0.45" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBackgroundBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource ActiveNavBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActiveNavBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ActiveNavForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TagStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource TagBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="StatusTagTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusTagBorderStyle" TargetType="Border" BasedOn="{StaticResource TagStyle}">
      <Setter Property="Background" Value="{DynamicResource SuccessTagBgBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter Property="Background" Value="{DynamicResource WarningTagBgBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="{DynamicResource SwitchOffBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track"
                    Width="44"
                    Height="24"
                    CornerRadius="12"
                    Background="{TemplateBinding Background}">
              <Ellipse x:Name="Thumb"
                       Width="18"
                       Height="18"
                       Fill="{DynamicResource SwitchThumbBrush}"
                       HorizontalAlignment="Left"
                       Margin="3,0,0,0">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.24" />
                </Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WindowControlForegroundBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource WindowControlHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource WindowControlPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E81123" />
                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#C50F1F" />
                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">

    <Border x:Name="ShellBorder"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource ShellBackgroundBrush}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Margin" Value="0" />
          <Setter Property="CornerRadius" Value="12" />
          <Setter Property="Effect" Value="{x:Null}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
              <Setter Property="Margin" Value="0" />
              <Setter Property="CornerRadius" Value="0" />
              <Setter Property="Effect" Value="{x:Null}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource TopBarBorderBrush}"
                BorderThickness="0,0,0,1">
          <Grid Margin="16,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="pack://application:,,,/Resources/icon.ico"
                     Width="28" Height="28"
                     Margin="0,0,12,0"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Portable ConvertX" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text=" "
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <ToggleButton x:Name="ToolStatusToggle"
                            Style="{StaticResource StatusToggleStyle}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding AvailableToolSummary}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>

              <Popup PlacementTarget="{Binding ElementName=ToolStatusToggle}"
                     Placement="Bottom"
                     HorizontalOffset="-230"
                     VerticalOffset="10"
                     StaysOpen="False"
                     IsOpen="{Binding IsChecked, ElementName=ToolStatusToggle}">
                <Border Width="360"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        BorderBrush="{DynamicResource PopupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.35" />
                  </Border.Effect>
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}" Background="{DynamicResource SuccessTagBgBrush}">
                        <TextBlock Text="健康" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="本地转换器" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ToolStatuses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource PanelSoftBackgroundBrush}"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="8"
                                  Padding="10,8"
                                  Margin="0,0,0,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                              </StackPanel>
                              <Border Grid.Column="1" Style="{StaticResource StatusTagBorderStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTagTextStyle}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>

            <Button Grid.Column="2"
                    Content="⚙"
                    ToolTip="设置"
                    Click="SettingsNav_Click"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button x:Name="MinimizeButton"
                      Style="{StaticResource WindowControlButtonStyle}"
                      Click="MinimizeButton_Click"
                      ToolTip="最小化">
                <Path Width="10" Height="1"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      Data="M0,0 L10,0" />
              </Button>
              <Button x:Name="MaximizeRestoreButton"
                      Click="MaximizeRestoreButton_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                    <Setter Property="ToolTip" Value="最大化" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="ToolTip" Value="还原" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid Width="10" Height="10">
                  <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             StrokeThickness="1"
                             Fill="Transparent">
                    <Rectangle.Style>
                      <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Rectangle.Style>
                  </Rectangle>
                  <Grid>
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Rectangle Width="8" Height="8"
                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               StrokeThickness="1"
                               Fill="Transparent"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top" />
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Fill="Transparent"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Data="M0,2 L0,8 L6,8 L6,2 Z M0,2 L6,2" />
                  </Grid>
                </Grid>
              </Button>
              <Button x:Name="CloseButton"
                      Style="{StaticResource WindowCloseButtonStyle}"
                      Click="CloseButton_Click"
                      ToolTip="关闭">
                <Path Width="10" Height="10"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      Data="M0,0 L10,10 M10,0 L0,10" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="198" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="{DynamicResource SidebarBackgroundBrush}"
                  BorderBrush="{DynamicResource SidebarBorderBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="10,14">
            <StackPanel>
              <TextBlock Text="转换" Foreground="{DynamicResource QuietBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,8" />
              <Button x:Name="HomeNavButton" Style="{StaticResource ActiveNavButtonStyle}" Click="HomeNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⇄" Foreground="{DynamicResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="首页" />
                </StackPanel>
              </Button>
              <Button x:Name="AgentNavButton" Style="{StaticResource NavButtonStyle}" Click="AgentNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="AI Agent" />
                </StackPanel>
              </Button>

              <TextBlock Text="管理" Foreground="{DynamicResource QuietBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,18,0,8" />
              <!-- <Button Style="{StaticResource NavButtonStyle}" Click="ConvertersNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="◫" Foreground="{StaticResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="转换器" />
                </StackPanel>
              </Button> -->
              <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsNav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚙" Foreground="{DynamicResource AccentBrush}" FontSize="16" Width="26" />
                  <TextBlock Text="设置" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Hidden">
              <StackPanel Margin="14,12,14,14">
                <DockPanel x:Name="HomeSection" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="文件转换" FontSize="23" FontWeight="SemiBold" />
                  <TextBlock Text="选择输入文件、目标格式和转换器，输出结果会保存在指定目录。"
                             Foreground="{DynamicResource MutedBrush}"
                             FontSize="14"
                             Margin="0,6,0,0" />
                </StackPanel>
              </DockPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.45*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="0.9*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="单文件模式" Foreground="{DynamicResource TagForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="转换任务" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            MinHeight="120"
                            Padding="20"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource DropZoneBorderBrush}"
                            BorderThickness="2"
                            Background="{DynamicResource DropZoneBackgroundBrush}"
                            AllowDrop="True"
                            Drop="DropZone_Drop"
                            DragOver="DropZone_DragOver">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="拖入文件或点击选择" FontSize="17" FontWeight="SemiBold" />
                          <TextBox Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}"
                                   IsReadOnly="True"
                                   Margin="0,8,0,0" />
                          <TextBlock Text="可拖拽单个文件到这里，应用会自动识别可用输出格式。"
                                     Foreground="{DynamicResource MutedBrush}"
                                     FontSize="13"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="选择输入文件"
                                Style="{StaticResource BaseButtonStyle}"
                                Click="ChooseFile_Click"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0" />
                      </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="输出格式" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding SelectedOutputFormat}" />
                      </StackPanel>

                      <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="转换器" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ConverterOptions}"
                                  SelectedItem="{Binding SelectedConverterOption}"
                                  DisplayMemberPath="DisplayName" />
                      </StackPanel>

                      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                          <Button Grid.Column="2"
                                  Content="选择目录"
                                  Style="{StaticResource BaseButtonStyle}"
                                  Click="ChooseOutputDirectory_Click" />
                        </Grid>
                      </StackPanel>

                      <Border Grid.Row="4"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Padding="10"
                              CornerRadius="10"
                              Background="{DynamicResource PanelSoftBackgroundBrush}"
                              BorderBrush="{DynamicResource LineSoftBrush}"
                              BorderThickness="1">
                        <DockPanel>
                          <ToggleButton x:Name="NvidiaAccelerationToggle"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SwitchToggleStyle}"
                                        ToolTip="开启后自动写入 ffmpeg CUDA/NVENC 参数"
                                        Checked="NvidiaAccelerationToggle_Checked"
                                        Unchecked="NvidiaAccelerationToggle_Unchecked"
                                        Margin="16,0,0,0" />
                          <StackPanel>
                            <TextBlock Text="ffmpeg NVIDIA 硬件加速" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="预留参数：-hwaccel cuda -c:v h264_nvenc，默认关闭"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                          </StackPanel>
                        </DockPanel>
                      </Border>

                      <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="高级参数" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding AdvancedArguments, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：-crf 20 -preset fast" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Content="开始转换"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Click="StartConvert_Click"
                              IsEnabled="{Binding CanStart}"
                              Margin="0,0,10,0" />
                      <Button Content="取消"
                              Style="{StaticResource BaseButtonStyle}"
                              Click="CancelConvert_Click"
                              IsEnabled="{Binding IsConverting}"
                              Margin="0,0,10,0" />
                      <Button Content="打开结果文件夹"
                              Style="{StaticResource BaseButtonStyle}"
                              Click="OpenOutputDirectory_Click" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="12,9"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource SuccessBgBrush}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="✓" Foreground="{DynamicResource SuccessTextBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="13" FontWeight="Bold" />
                          <TextBlock Text="{Binding OutputDirectory}" Foreground="{DynamicResource SuccessSoftTextBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <Border Style="{StaticResource PanelBorderStyle}" Padding="0" Height="360">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}" Background="{DynamicResource SuccessTagBgBrush}">
                          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="简单终端" FontSize="17" FontWeight="SemiBold" />
                      </DockPanel>
                      <Border Grid.Row="1"
                              Margin="0"
                              CornerRadius="10"
                              Background="{DynamicResource TerminalBrush}"
                              ClipToBounds="True">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <DockPanel Background="{DynamicResource TerminalBarBrush}" LastChildFill="False">
                            <TextBlock Text="转换日志"
                                       Foreground="{DynamicResource TerminalLabelBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="实时输出"
                                       Foreground="{DynamicResource TerminalLabelBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                          </DockPanel>
                          <TextBox Grid.Row="1"
                                   Text="{Binding LogText}"
                                   IsReadOnly="True"
                                   TextWrapping="Wrap"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   Background="{DynamicResource TerminalBrush}"
                                   Foreground="{DynamicResource TerminalForegroundBrush}"
                                   BorderThickness="0"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="13"
                                   Padding="12"
                                   VerticalContentAlignment="Top" />
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>

                </StackPanel>
              </Grid>

              </StackPanel>
            </ScrollViewer>

            <Grid x:Name="AgentPage" Visibility="Collapsed">
              <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="AI Assistant" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="描述转换目标，Agent 会把回答收束为可执行 PowerShell 命令。"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="14"
                               Margin="0,6,0,0" />
                  </StackPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                    <TextBlock Text="{Binding AgentStatusText}" Foreground="{DynamicResource TagForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </DockPanel>

                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="430" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.9*" MinWidth="330" />
                  </Grid.ColumnDefinitions>

                  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                          <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                            <TextBlock Text="Request" Foreground="{DynamicResource TagForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                          </Border>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Conversion Request" FontSize="17" FontWeight="SemiBold" />
                          </StackPanel>
                        </DockPanel>

                        <Border MinHeight="104"
                                Padding="18"
                                CornerRadius="12"
                                BorderBrush="{DynamicResource DropZoneBorderBrush}"
                                BorderThickness="2"
                                Background="{DynamicResource DropZoneBackgroundBrush}"
                                AllowDrop="True"
                                Drop="AgentDropZone_Drop"
                                DragOver="DropZone_DragOver"
                                Margin="0,0,0,12">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="拖入文件或点击选择" FontSize="16" FontWeight="SemiBold" />
                              <TextBox Text="{Binding AgentInputFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,8,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="选择文件"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AgentChooseFile_Click"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0" />
                          </Grid>
                        </Border>

                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="170" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox Text="{Binding AgentOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                              <Button Grid.Column="2" Content="更改" Style="{StaticResource BaseButtonStyle}" Click="AgentChooseOutputDirectory_Click" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="目标格式" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AgentOutputFormats}" SelectedItem="{Binding AgentSelectedOutputFormat}" />
                          </StackPanel>
                        </Grid>

                        <StackPanel>
                          <TextBlock Text="你想怎么转换？" Style="{StaticResource FieldLabelStyle}" />
                          <TextBox Text="{Binding AgentRequestText, UpdateSourceTrigger=PropertyChanged}"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="108"
                                   ToolTip="例如：压缩到 50MB 以下，保持 1080p，并移除音轨" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                          <Button Content="发送给 Agent" Style="{StaticResource PrimaryButtonStyle}" Click="AgentGenerate_Click" IsEnabled="{Binding CanStartAgent}" />
                          <Button Content="复制命令" Style="{StaticResource BaseButtonStyle}" Click="AgentCommandPreview_Copy" />
                          <Button Content="打开目录" Style="{StaticResource BaseButtonStyle}" Click="AgentOpenOutputDirectory_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Height="318">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="38" />
                          <RowDefinition Height="*" />
                          <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <DockPanel Background="{DynamicResource TerminalBarBrush}">
                          <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="▸" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="PowerShell" Foreground="{DynamicResource TerminalLabelBrush}" FontSize="12" FontWeight="SemiBold" />
                          </StackPanel>
                          <TextBlock DockPanel.Dock="Right"
                                     Text="只读命令自动执行，写入命令需确认"
                                     Foreground="{DynamicResource TerminalLabelBrush}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0" />
                        </DockPanel>
                        <Grid Grid.Row="1" Background="{DynamicResource TerminalBrush}">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <TextBox Text="{Binding AgentCommandInput, UpdateSourceTrigger=PropertyChanged}"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   Background="{DynamicResource TerminalBrush}"
                                   Foreground="{DynamicResource TerminalForegroundBrush}"
                                   BorderThickness="0"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="13"
                                   Padding="12"
                                   MinHeight="72" />
                          <TextBox Grid.Row="1"
                                   Text="{Binding AgentTerminalLog}"
                                   IsReadOnly="True"
                                   TextWrapping="Wrap"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   Background="{DynamicResource TerminalBrush}"
                                   Foreground="{DynamicResource TerminalForegroundBrush}"
                                   BorderThickness="0"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="12"
                                   Padding="12,0,12,12" />
                        </Grid>
                        <DockPanel Grid.Row="2" Background="{DynamicResource TerminalBarBrush}" LastChildFill="False">
                          <Button x:Name="RunCommandButton"
                                  Content="运行命令"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Click="AgentRunPowerShell_Click"
                                  Margin="0,4,8,4" />
                          <Button Content="执行转换" Style="{StaticResource BaseButtonStyle}" Click="AgentExecuteRecommended_Click" IsEnabled="{Binding CanStartAgent}" Margin="0,4,8,4" />
                          <Button DockPanel.Dock="Right"
                                  Content="清除"
                                  Style="{StaticResource BaseButtonStyle}"
                                  Click="AgentClearTerminal_Click"
                                  Margin="0,4,0,4" />
                        </DockPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                  </ScrollViewer>

                  <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="AI" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ConvertX Assistant" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsAgentBusy}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                              <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="在线 · 已就绪" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsAgentBusy}" Value="True">
                                        <Setter Property="Text" Value="正在思考…" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="新建会话"
                                Style="{StaticResource BaseButtonStyle}"
                                Click="AgentNewChat_Click"
                                VerticalAlignment="Center"
                                ToolTip="清空当前对话，开启新会话" />
                      </Grid>

                      <ComboBox Grid.Row="1"
                                ItemsSource="{Binding AgentHistory}"
                                SelectedItem="{Binding SelectedAgentHistory}"
                                SelectionChanged="AgentHistorySelectionChanged"
                                DisplayMemberPath="DisplayLabel"
                                ToolTip="切换到历史会话"
                                Margin="16,0,16,10" />

                      <Border Grid.Row="2"
                              Background="{DynamicResource PanelSoftBackgroundBrush}"
                              BorderThickness="0"
                              ClipToBounds="True">
                        <Grid>
                          <Border>
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ShowChatEmptyState}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="320">
                              <Border Width="58" Height="58" CornerRadius="29" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="ConvertX Assistant"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Center" />
                              <TextBlock Text="选好文件和目标格式，描述你想要的转换效果，我会生成可执行命令。"
                                         Foreground="{DynamicResource MutedBrush}"
                                         FontSize="12"
                                         HorizontalAlignment="Center"
                                         TextAlignment="Center"
                                         Margin="0,6,0,16" />
                              <TextBlock Text="试试这些"
                                         Style="{StaticResource FieldLabelStyle}"
                                         HorizontalAlignment="Center" />
                              <Button Style="{StaticResource BaseButtonStyle}"
                                      Click="AgentQuickPrompt_Click"
                                      Tag="把它压缩到 50MB 以下，尽量保持画质"
                                      Content="把它压缩到 50MB 以下，尽量保持画质"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,6" />
                              <Button Style="{StaticResource BaseButtonStyle}"
                                      Click="AgentQuickPrompt_Click"
                                      Tag="提取音轨为 mp3"
                                      Content="提取音轨为 mp3"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,6" />
                              <Button Style="{StaticResource BaseButtonStyle}"
                                      Click="AgentQuickPrompt_Click"
                                      Tag="转 1080p mp4，启用 NVIDIA 加速"
                                      Content="转 1080p mp4，启用 NVIDIA 加速"
                                      HorizontalAlignment="Stretch" />
                            </StackPanel>
                          </Border>

                          <ScrollViewer x:Name="AgentMessagesScrollViewer"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        CanContentScroll="False"
                                        Padding="16"
                                        ScrollChanged="AgentMessagesScrollViewer_ScrollChanged"
                                        PreviewMouseWheel="AgentMessagesScrollViewer_PreviewMouseWheel">
                            <ScrollViewer.Style>
                              <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ShowChatEmptyState}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                              <ItemsControl ItemsSource="{Binding AgentMessages}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>

                                      <Border x:Name="AvatarLeft"
                                              Width="30" Height="30"
                                              CornerRadius="15"
                                              Background="{DynamicResource AccentSoftBrush}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,8,0">
                                        <TextBlock Text="AI"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                      </Border>

                                      <StackPanel x:Name="BodyStack"
                                                  Grid.Column="1"
                                                  MaxWidth="520"
                                                  HorizontalAlignment="Left">
                                        <DockPanel Margin="0,0,0,4">
                                          <TextBlock x:Name="SenderText"
                                                     Text="ConvertX Assistant"
                                                     Foreground="{DynamicResource MutedBrush}"
                                                     FontSize="11"
                                                     FontWeight="SemiBold" />
                                          <TextBlock Text="{Binding DisplayTime}"
                                                     Foreground="{DynamicResource QuietBrush}"
                                                     FontSize="10"
                                                     Margin="6,0,0,0"
                                                     VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid x:Name="BubbleHost">
                                          <Border x:Name="BubbleBorder"
                                                  Background="{DynamicResource PanelBackgroundBrush}"
                                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                                  BorderThickness="1"
                                                  CornerRadius="14,14,14,4"
                                                  Padding="12,10">
                                            <controls:MarkdownViewer x:Name="MarkdownContent"
                                                                      Focusable="False"
                                                                      Markdown="{Binding Content}"
                                                                      BubbleForeground="{DynamicResource TextBrush}"
                                                                      FontFamily="Inter, Segoe UI, Microsoft YaHei UI"
                                                                      FontSize="13" />
                                          </Border>
                                          <Button Click="AgentBubbleCopy_Click"
                                                  Tag="{Binding Content}"
                                                  Content="复制"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Margin="0,6,8,0"
                                                  MinHeight="22"
                                                  Padding="8,0"
                                                  FontSize="11"
                                                  FontWeight="Normal"
                                                  ToolTip="复制此消息内容">
                                            <Button.Style>
                                              <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=BubbleHost}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </Button.Style>
                                          </Button>
                                        </Grid>
                                      </StackPanel>

                                      <Border x:Name="AvatarRight"
                                              Grid.Column="2"
                                              Width="30" Height="30"
                                              CornerRadius="15"
                                              Background="{DynamicResource AccentBrush}"
                                              VerticalAlignment="Top"
                                              Margin="8,2,0,0"
                                              Visibility="Collapsed">
                                        <TextBlock Text="你"
                                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                      </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="AvatarLeft" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AvatarRight" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="BodyStack" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="SenderText" Property="Text" Value="你" />
                                        <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="BubbleBorder" Property="CornerRadius" Value="14,14,4,14" />
                                        <Setter TargetName="MarkdownContent" Property="BubbleForeground" Value="{DynamicResource AccentForegroundBrush}" />
                                      </DataTrigger>
                                    </DataTemplate.Triggers>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <Grid Margin="0,0,0,14">
                                <Grid.Style>
                                  <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsAgentBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30"
                                        CornerRadius="15"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,2,8,0">
                                  <TextBlock Text="AI"
                                             Foreground="{DynamicResource AccentBrush}"
                                             FontWeight="Bold"
                                             FontSize="11"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14,14,14,4"
                                        Padding="14,10">
                                  <TextBlock Text="● ● ●"
                                             Foreground="{DynamicResource MutedBrush}"
                                             FontSize="12" />
                                </Border>
                              </Grid>
                            </StackPanel>
                          </ScrollViewer>
                        </Grid>
                      </Border>

                      <Grid Grid.Row="3" Margin="16,12,16,16">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="10" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AgentChatInputBox"
                                 Text="{Binding AgentChatInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 MinHeight="66"
                                 TextWrapping="Wrap"
                                 KeyDown="AgentChatInput_KeyDown"
                                 ToolTip="Enter 发送，Shift+Enter 换行" />
                        <Button Grid.Column="2"
                                Content="发送"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AgentSendChat_Click"
                                IsEnabled="{Binding CanSendChat}"
                                VerticalAlignment="Bottom" />
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
              <StackPanel Margin="14,12,14,14">
                <StackPanel x:Name="SettingsSection">
                <DockPanel Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="设置" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="这里展示后续设置页的布局结构，正式开发时可映射到 WPF-UI NavigationView 页面。"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="14"
                               Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="AI" Foreground="{DynamicResource TagForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="AI 模型配置" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="API 类型" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding AgentProviderType}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="模型名称" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding AgentModel, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>

                      <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="请求地址" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding AgentEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>

                      <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox x:Name="AgentApiKeyBox"
                                     MinHeight="36"
                                     Padding="10,7"
                                     PasswordChanged="AgentApiKeyBox_PasswordChanged" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button Content="保存配置" Style="{StaticResource PrimaryButtonStyle}" Click="AgentSaveSettings_Click" />
                      <Button Content="测试连接" Style="{StaticResource BaseButtonStyle}" Click="AgentTestConnection_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="Advanced" Foreground="{DynamicResource TagForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="高级设置" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <CheckBox Content="启用命令行执行"
                              IsChecked="{Binding EnableCommandLineExecution, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="开启后才会在 AI Agent 区显示“运行命令”按钮" />
                    <TextBlock Text="默认关闭。小白用户只需使用“执行转换”，系统会走 ConvertX 的安全执行器。"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12"
                               Margin="0,8,0,0" />
                  </StackPanel>
                </Border>

                <Border x:Name="ConverterManagementSection" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <TextBlock Text="转换器管理" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ToolStatuses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource PanelSoftBackgroundBrush}"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="8"
                                  Padding="10,8"
                                  Margin="0,0,0,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="3" Style="{StaticResource StatusTagBorderStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTagTextStyle}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <Border DockPanel.Dock="Right" Style="{StaticResource TagStyle}">
                        <TextBlock Text="Theme" Foreground="{DynamicResource TagForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="主题设置" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border x:Name="ThemeCardLight"
                              Padding="14" CornerRadius="10"
                              Background="{DynamicResource ThemeCardBackgroundBrush}"
                              BorderBrush="{DynamicResource ThemeCardSelectedBorderBrush}"
                              BorderThickness="2"
                              Cursor="Hand"
                              MouseLeftButtonUp="ThemeCardLight_Click">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FFFFFFFF" BorderBrush="{DynamicResource ThemeCardSwatchBorderBrush}" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FFEEF3F8" BorderBrush="{DynamicResource ThemeCardSwatchBorderBrush}" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FF0067C0" />
                          </StackPanel>
                          <TextBlock Text="浅色主题" FontWeight="SemiBold" />
                          <TextBlock Text="Mica + 浅色 Fluent" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>

                      <Border x:Name="ThemeCardDark"
                              Grid.Column="2"
                              Padding="14" CornerRadius="10"
                              Background="{DynamicResource ThemeCardBackgroundBrush}"
                              BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                              BorderThickness="2"
                              Cursor="Hand"
                              MouseLeftButtonUp="ThemeCardDark_Click">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FF10151F" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FF1D2532" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FF4CC2FF" />
                          </StackPanel>
                          <TextBlock Text="暗黑主题" FontWeight="SemiBold" />
                          <TextBlock Text="高对比终端友好" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>

                      <Border x:Name="ThemeCardSystem"
                              Grid.Column="4"
                              Padding="14" CornerRadius="10"
                              Background="{DynamicResource ThemeCardBackgroundBrush}"
                              BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                              BorderThickness="2"
                              Cursor="Hand"
                              MouseLeftButtonUp="ThemeCardSystem_Click">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FFF7FBFF" BorderBrush="{DynamicResource ThemeCardSwatchBorderBrush}" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FF10151F" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrush}" />
                          </StackPanel>
                          <TextBlock Text="系统跟随" FontWeight="SemiBold" />
                          <TextBlock Text="跟随 Windows 主题" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
