<Window x:Class="ConvertXPortable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portable ConvertX" Height="720" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">
  <Grid Background="#F6F7F9">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="0,0,0,1" Padding="24,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AvailableToolSummary}" VerticalAlignment="Center" Foreground="#445064" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Portable ConvertX" FontSize="24" FontWeight="SemiBold" Foreground="#19202A" />
          <TextBlock Text="统一调用 TestTools 中的便携转换器" Foreground="#5F6B7A" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="#B8C2D1" BorderThickness="1" CornerRadius="6" Background="#FBFCFE"
                  Padding="18" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="输入文件" FontWeight="SemiBold" Foreground="#1C2430" />
                <TextBox Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                         Margin="0,10,0,0" MinHeight="36" />
                <TextBlock Text="可拖拽单个文件到这里" Foreground="#6C7788" Margin="0,8,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="选择文件" Click="ChooseFile_Click" Margin="16,28,0,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="输出格式" FontWeight="SemiBold" Foreground="#1C2430" />
              <ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}"
                        Margin="0,8,0,0" MinHeight="36" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="转换器" FontWeight="SemiBold" Foreground="#1C2430" />
              <ComboBox ItemsSource="{Binding ConverterOptions}" SelectedItem="{Binding SelectedConverterOption}"
                        DisplayMemberPath="DisplayName" Margin="0,8,0,0" MinHeight="36" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="输出目录" FontWeight="SemiBold" Foreground="#1C2430" />
              <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" MinHeight="36" />
            </StackPanel>
            <Button Grid.Column="1" Content="选择目录" Click="ChooseOutputDirectory_Click" Margin="16,28,0,0" />
          </Grid>

          <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="高级参数" FontWeight="SemiBold" Foreground="#1C2430" />
            <TextBox Text="{Binding AdvancedArguments, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,8,0,0" MinHeight="36" />
          </StackPanel>

          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,20,0,14">
            <Button Content="开始转换" Click="StartConvert_Click" IsEnabled="{Binding CanStart}" Background="#246BFD" Foreground="White" />
            <Button Content="取消" Click="CancelConvert_Click" IsEnabled="{Binding IsConverting}" />
            <Button Content="打开输出目录" Click="OpenOutputDirectory_Click" />
          </StackPanel>

          <Border Grid.Row="5" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Background="#111827">
            <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="#111827" Foreground="#E5E7EB" BorderThickness="0"
                     FontFamily="Consolas" FontSize="13" Padding="12" />
          </Border>

          <TextBlock Grid.Row="6" Text="{Binding StatusText}" Foreground="#445064" Margin="0,12,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="18" Margin="18,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="本地工具状态" FontSize="18" FontWeight="SemiBold" Foreground="#19202A" />
            <TextBlock Text="{Binding RootStatusText}" Foreground="#6C7788" Margin="0,4,0,12" TextWrapping="Wrap" />
          </StackPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding ToolStatuses}" BorderBrush="#D8DEE8">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="工具" DisplayMemberBinding="{Binding Name}" Width="120" />
                <GridViewColumn Header="分类" DisplayMemberBinding="{Binding Category}" Width="90" />
                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding StatusText}" Width="120" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
